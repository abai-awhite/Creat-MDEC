{
	chapter.0BE61D98EC2E6FEF.title: "保管と収納(@Create:Storage)"
	chapter.1505E388615EF814.title: "合金精錬炉(@Alloy Smelter)"
	chapter.1B463ED58F5BC382.title: "宝石\\&アクセサリー(@Iron's Gems 'n Jewelry)"
